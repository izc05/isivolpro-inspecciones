{
  "name": "isivolt-pro-inspecciones",
  "version": "1.5.8",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "dev:pc": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "test:sync": "node --test src/sync/*.test.js src/closure/*.test.js",
    "test:server": "for file in server/pocketbase/pb_migrations/*.js server/pocketbase/pb_hooks/*.js; do node --check \"$file\"; done && bash -n server/pocketbase/deploy/install-local.sh",
    "test:integration": "npm run test:sync && npm run test:server && npm run build",
    "smoke:sync-server": "node scripts/smoke-sync-server.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run build && cap sync android",
    "cap:open": "cap open android",
    "android:apk": "npm run build && cap sync android && cd android && gradlew.bat assembleDebug",
    "android:aab": "npm run build && cap sync android && cd android && gradlew.bat bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "firebase": "^12.13.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.468.0",
    "pdf-parse": "^2.4.5",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  }
}
